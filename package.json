{
  "name": "syntaxstitch",
  "displayName": "SyntaxStitch",
  "description": "Cross-platform support for VS Code on Windows, macOS, and Linux. Stops mismatched brackets, quotes, tags, and indentation from turning AI edits into cascading syntax failures, with Nested Select for faster structured editing.",
  "version": "0.0.8",
  "publisher": "BrockNash",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neonash7777/SyntaxStitch.git"
  },
  "homepage": "https://github.com/neonash7777/SyntaxStitch#readme",
  "bugs": {
    "url": "https://github.com/neonash7777/SyntaxStitch/issues"
  },
  "keywords": [
    "AI",
    "brackets",
    "braces",
    "parenthesis",
    "parentheses",
    "quotes",
    "matching",
    "syntax",
    "repair",
    "fix",
    "indent",
    "indentation",
    "token",
    "tokens",
    "consumption",
    "reducer",
    "Copilot",
    "productivity",
    "HTML",
    "CSS",
    "Python"
  ],
  "engines": {
    "vscode": "^1.127.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:syntaxstitch.deleteLeft",
    "onCommand:syntaxstitch.deleteRight"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "syntaxstitch.showMenu",
        "title": "SyntaxStitch: Show Actions"
      },
      {
        "command": "syntaxstitch.openSettings",
        "title": "SyntaxStitch: Open Settings"
      },
      {
        "command": "syntaxstitch.toggle",
        "title": "SyntaxStitch: Toggle On/Off"
      },
      {
        "command": "syntaxstitch.selectMatchingStructure",
        "title": "SyntaxStitch: Select Matching Structure"
      },
      {
        "command": "syntaxstitch.selectInnerStructure",
        "title": "SyntaxStitch: Select Inner Structure"
      },
      {
        "command": "syntaxstitch.enterStructuralSelectionMode",
        "title": "SyntaxStitch: Enter Nested Select"
      },
      { "command": "syntaxstitch.exitStructuralSelectionTyping", "title": "SyntaxStitch: Nested Select: Finish Typing" },
      { "command": "syntaxstitch.exitStructuralSelectionMode", "title": "SyntaxStitch: Exit Nested Select" },
      { "command": "syntaxstitch.structuralSelectionNext", "title": "SyntaxStitch: Nested Select: Focus Next Selection" },
      { "command": "syntaxstitch.structuralSelectionPrevious", "title": "SyntaxStitch: Nested Select: Focus Previous Selection" },
      { "command": "syntaxstitch.structuralSelectionComponents", "title": "SyntaxStitch: Nested Select: Select Inner Components" },
      { "command": "syntaxstitch.structuralSelectionExpandRight", "title": "SyntaxStitch: Nested Select: Add Next Selection" },
      { "command": "syntaxstitch.structuralSelectionExpandLeft", "title": "SyntaxStitch: Nested Select: Add Previous Selection" },
      { "command": "syntaxstitch.structuralSelectionToggle", "title": "SyntaxStitch: Nested Select: Toggle Focused Highlight" },
      { "command": "syntaxstitch.structuralSelectionDelete", "title": "SyntaxStitch: Nested Select: Remove Focused Selection" },
      { "command": "syntaxstitch.structuralSelectionEnter", "title": "SyntaxStitch: Nested Select: Enter Focused Structure" },
      { "command": "syntaxstitch.structuralSelectionDrillDown", "title": "SyntaxStitch: Nested Select: Cycle to Next Sibling" },
      { "command": "syntaxstitch.structuralSelectionDrillUp", "title": "SyntaxStitch: Nested Select: Cycle to Previous Sibling" },
      { "command": "syntaxstitch.structuralSelectionHome", "title": "SyntaxStitch: Nested Select: Focus First Selection" },
      { "command": "syntaxstitch.structuralSelectionEnd", "title": "SyntaxStitch: Nested Select: Focus Last Selection" },
      {
        "command": "syntaxstitch.structuralTab",
        "title": "SyntaxStitch: Structural Tab"
      },
      {
        "command": "syntaxstitch.showStatistics",
        "title": "SyntaxStitch: Show Repair Statistics"
      },
      {
        "command": "syntaxstitch.configurePairLabels",
        "title": "SyntaxStitch: Configure Pair Labels"
      },
      {
        "command": "syntaxstitch.resetStatistics",
        "title": "SyntaxStitch: Reset Repair Count"
      },
      {
        "command": "syntaxstitch.rebuildShadowIndex",
        "title": "SyntaxStitch: Rebuild Shadow Index"
      },
      {
        "command": "syntaxstitch.inspectActiveDocument",
        "title": "SyntaxStitch: Inspect Active Document"
      },
      {
        "command": "syntaxstitch.showOutput",
        "title": "SyntaxStitch: Show Reconciliation Output"
      },
      {
        "command": "syntaxstitch.toggleFilePause",
        "title": "SyntaxStitch: Pause / Resume This File"
      },
      {
        "command": "syntaxstitch.skipNextRepair",
        "title": "SyntaxStitch: Skip Next Edit / Cancel Skip"
      },
      {
        "command": "syntaxstitch.chooseMirroringScope",
        "title": "SyntaxStitch: Choose Mirrored Edit Scope"
      },
      {
        "command": "syntaxstitch.showRecentRepairs",
        "title": "SyntaxStitch: Show Recent Repairs"
      },
      {
        "command": "syntaxstitch.clearRecentRepairs",
        "title": "SyntaxStitch: Clear Recent Repairs"
      },
      {
        "command": "syntaxstitch.openPractice",
        "title": "SyntaxStitch: Nested Select Tutorial"
      }
    ],
    "keybindings": [
      {
        "command": "syntaxstitch.deleteLeft",
        "key": "backspace",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "syntaxstitch.deleteRight",
        "key": "delete",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "syntaxstitch.structuralTab",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && !inSnippetMode && !suggestWidgetVisible && !inlineSuggestionVisible && !editorTabMovesFocus"
      },
      {
        "command": "syntaxstitch.selectMatchingStructure",
        "key": "ctrl+alt+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "syntaxstitch.selectMatchingStructure",
        "key": "cmd+pageup",
        "when": "editorTextFocus && isMac"
      },
      {
        "command": "syntaxstitch.selectInnerStructure",
        "key": "cmd+pagedown",
        "when": "editorTextFocus && editorHasSelection && isMac"
      },
      {
        "command": "syntaxstitch.enterStructuralSelectionMode",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "syntaxstitch.enterStructuralSelectionMode",
        "key": "cmd+alt+s",
        "when": "editorTextFocus && editorHasSelection && isMac"
      },
      {
        "command": "syntaxstitch.enterStructuralSelectionMode",
        "key": "cmd+alt+enter",
        "when": "editorTextFocus && editorHasSelection && isMac"
      },
      {
        "command": "syntaxstitch.enterStructuralSelectionMode",
        "key": "cmd+alt+right",
        "when": "editorTextFocus && editorHasSelection && isMac"
      },
      { "command": "syntaxstitch.structuralSelectionComponents", "key": "tab", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionPrevious", "key": "shift+tab", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionNext", "key": "right", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionPrevious", "key": "left", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDrillDown", "key": "down", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDrillUp", "key": "up", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionEnter", "key": "enter", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionExpandRight", "key": "shift+right", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionExpandLeft", "key": "shift+left", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDrillDown", "key": "shift+down", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDrillUp", "key": "shift+up", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "-cursorRightSelect", "key": "shift+right", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "-cursorLeftSelect", "key": "shift+left", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "-cursorDownSelect", "key": "shift+down", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "-cursorUpSelect", "key": "shift+up", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "syntaxstitch.structuralSelectionToggle", "key": "space", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDelete", "key": "delete", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDelete", "key": "forwarddelete", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "syntaxstitch.structuralSelectionDrillDown", "key": "pagedown", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDrillUp", "key": "pageup", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.exitStructuralSelectionTyping", "key": "enter", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.structuralSelectionDrillUp", "key": "shift+enter", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "syntaxstitch.structuralSelectionHome", "key": "home", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "syntaxstitch.structuralSelectionEnd", "key": "end", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode" },
      { "command": "syntaxstitch.exitStructuralSelectionTyping", "key": "escape", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && syntaxstitch.structuralSelectionTyping" },
      { "command": "syntaxstitch.exitStructuralSelectionMode", "key": "escape", "when": "editorTextFocus && syntaxstitch.structuralSelectionMode && !syntaxstitch.structuralSelectionTyping" }
    ],
    "configuration": {
      "title": "SyntaxStitch",
      "properties": {
        "syntaxstitch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Heal edits that remove exactly one half of an indexed structural pair."
        },
        "syntaxstitch.pairLabels": {
          "type": "string",
          "enum": [
            "off",
            "active",
            "all"
          ],
          "enumDescriptions": [
            "Hide pair ownership labels.",
            "Show the innermost pair containing the cursor.",
            "Show ownership labels at multiline, line-leading closing braces and tags."
          ],
          "default": "all",
          "description": "Render compact inline pair labels; hover the owner for ordinary-click folding and structural selection actions."
        },
        "syntaxstitch.fixClosingIndentation": {
          "type": "boolean",
          "default": true,
          "description": "Align a changed line-leading closing brace with the indentation of its matched opening brace."
        },
        "syntaxstitch.structures": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "parenthesis",
              "square",
              "curly",
              "brace",
              "tag",
              "quote",
              "indent"
            ]
          },
          "enumDescriptions": [
            "Repair (), parentheses.",
            "Repair [], square brackets.",
            "Repair {}, curly braces.",
            "Legacy umbrella: repair all three bracket families.",
            "Repair markup tags.",
            "Repair quoted strings and quote boundaries.",
            "Repair indentation boundaries."
          ],
          "uniqueItems": true,
          "default": [
            "parenthesis",
            "square",
            "curly",
            "tag",
            "quote",
            "indent"
          ],
          "description": "Structural pair types SyntaxStitch may repair. brace enables all (), [], and {} repairs; square, parenthesis, and curly can be selected individually."
        },
        "syntaxstitch.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "json",
            "jsonc",
            "html",
            "xml",
            "vue",
            "svelte",
            "astro",
            "css",
            "scss",
            "less",
            "python",
            "csharp",
            "java",
            "go",
            "rust"
          ],
          "description": "Language identifiers monitored by SyntaxStitch. Use an empty array to monitor every language."
        },
        "syntaxstitch.maxFileSizeKB": {
          "type": "integer",
          "minimum": 64,
          "default": 2048,
          "description": "Maximum UTF-8 document size SyntaxStitch indexes, in kilobytes."
        },
        "syntaxstitch.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "repairs",
            "verbose"
          ],
          "enumDescriptions": [
            "Do not write structured output.",
            "Write repairs and errors.",
            "Write repairs, errors, and state changes."
          ],
          "default": "repairs",
          "description": "Detail written to the SyntaxStitch output channel."
        },
        "syntaxstitch.flashStatus": {
          "type": "boolean",
          "default": true,
          "description": "Flash the SyntaxStitch status bar item when a repair is counted."
        },
        "syntaxstitch.repairCountCooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 5000,
          "description": "Time in milliseconds during which repeated repairs of the same boundary count as one incident. Set to 0 to count every repair."
        },
        "syntaxstitch.mirroredEditDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "default": 100,
          "description": "Delay in milliseconds before Nested Select applies mirrored edits automatically. Saving flushes queued edits immediately."
        },
        "syntaxstitch.mirroringScope": {
          "type": "string",
          "enum": [
            "selection",
            "enclosing",
            "document"
          ],
          "enumDescriptions": [
            "Only structures contained in the original selection.",
            "Structures inside the nearest enclosing structure captured on entry; falls back to the selection.",
            "Matching structures anywhere in the document."
          ],
          "default": "selection",
          "description": "Initial scope for Nested Select mirrored edits. Change the current session scope by clicking the Nested Select status item."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "syntaxstitch.getStarted",
        "title": "Nested Select Tutorial",
        "description": "Learn structured navigation and see exactly where matching edits apply.",
        "steps": [
          {
            "id": "practice",
            "title": "Open the practice file",
            "description": "Explore three nested div/span/span examples in a preselected, unsaved HTML document.\n[Open tutorial](command:syntaxstitch.openPractice)",
            "completionEvents": [
              "onCommand:syntaxstitch.openPractice"
            ]
          },
          {
            "id": "scope",
            "title": "Choose where edits apply",
            "description": "The original selection is the default. Click the Nested Select status item to choose the enclosing structure or the entire document. Dashed outlines preview the affected ranges.",
            "completionEvents": [
              "onCommand:syntaxstitch.chooseMirroringScope"
            ]
          },
          {
            "id": "control",
            "title": "Stay in control of repairs",
            "description": "Use the SyntaxStitch action menu to pause this file or skip the next edit. Recent Repairs explains automatic structural changes.\n[Open actions](command:syntaxstitch.showMenu)",
            "completionEvents": [
              "onCommand:syntaxstitch.showMenu"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package",
    "publish:marketplace": "npm run package && vsce publish",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:minimum": "VSCODE_TEST_VERSION=1.127.0 vscode-test",
    "test:unit": "npm run compile-tests && node --test out/test/*.unit.js",
    "test:unit:focused": "npm run compile-tests && node --test --test-name-pattern=\"$TEST_PATTERN\" out/test/*.unit.js",
    "test:unit:compiled": "node --test out/test/*.unit.js",
    "test:publish": "npm run compile-tests && npm run package && npm run test:unit:compiled && VSCODE_TEST_VERSION=1.127.0 vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "entities": "^4.5.0"
  }
}
