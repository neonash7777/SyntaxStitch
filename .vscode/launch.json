{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run SyntaxStitch Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "build SyntaxStitch"
		},
		{
			"name": "Run SyntaxStitch: Manual Test Lab (No Debugger)",
			"type": "extensionHost",
			"request": "launch",
			"noDebug": true,
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/manual-tests"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "build SyntaxStitch"
		}
	]
}
